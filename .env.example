# ===========================================================================
# MAS AI WORKFLOW CONFIGURATION
# ===========================================================================

# WORKFLOW_STRATEGY sets the operational mode:
# - "predefined": Follows scenario.xlsx steps & traces Figma paths. (Requires Figma token)
# - "autonomous": Uses LLM to plan its own steps toward the goal. (No Figma required)
WORKFLOW_STRATEGY=predefined

# ===========================================================================
# CORE ADAPTERS
# ===========================================================================

# Android Device ID (get via 'adb devices')
TARGET_DEVICE=your_device_id_here

# Figma Access (Required for Predefined mode)
FIGMA_ACCESS_TOKEN=your_figma_access_token_here
FIGMA_MCP_URL=https://mcp.figma.com/mcp
FIGMA_URL_QA=https://www.figma.com/design/<your-file-key>/...  # Used by check_figma_connection.py and both modes at runtime

# ===========================================================================
# GLOBAL PROVIDER KEYS
# ===========================================================================
# If agent-specific keys are not set, these will be used automatically.
# Supported providers: openrouter | blackbox | openai | cursor | local

OPENROUTER_API_KEY=your_openrouter_key
BLACKBOX_API_KEY=your_blackbox_key
CURSOR_API_KEY=your_cursor_key
OPENAI_API_KEY=your_openai_key

# ===========================================================================
# AGENT CONFIGS
# ===========================================================================

OBSERVER_PROVIDER=blackbox
OBSERVER_MODEL=blackboxai/google/gemini-3.1-pro-preview

DECIDER_PROVIDER=blackbox
DECIDER_MODEL=blackboxai/minimax/minimax-m2.5

REFLECTOR_PROVIDER=blackbox
REFLECTOR_MODEL=blackboxai/google/gemini-3.1-pro-preview

ORCHESTRATOR_PROVIDER=blackbox
ORCHESTRATOR_MODEL=blackboxai/minimax/minimax-m2.5

# ===========================================================================
# SYSTEM SETTINGS
# ===========================================================================
LOCAL_LLM_URL=http://localhost:11434/v1
MAX_TOKENS=15000
OUTPUT_DIR=outputs
TOKEN_CONTEXT_WINDOW=128000
TOKEN_WARN_THRESHOLD=0.75

# ===========================================================================
# OMNIPARSER VISION BACKEND (optional — Stage 1 CV replacement)
# ===========================================================================
# Set OMNIPARSER_ENABLED=true after downloading model weights.
#
# Download weights (run once from the OmniParser project root):
#   for f in icon_detect/{train_args.yaml,model.pt,model.yaml} icon_caption/{config.json,generation_config.json,model.safetensors}; do
#     huggingface-cli download microsoft/OmniParser-v2.0 "$f" --local-dir weights
#   done
#   mv weights/icon_caption weights/icon_caption_florence
#
# OMNIPARSER_ENABLED=false
# OMNIPARSER_PROJECT_DIR=C:/Users/radit/Project/VisualStudioProject/Skripsi/OmniParser
# OMNIPARSER_WEIGHTS_DIR=C:/Users/radit/Project/VisualStudioProject/Skripsi/OmniParser/weights
# OMNIPARSER_BOX_THRESHOLD=0.05
