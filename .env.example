# DECIDER_PROVIDER=gemini
# DECIDER_MODEL=gemini-2.5-flash

# REFLECTOR_PROVIDER=gemini
# REFLECTOR_MODEL=gemini-2.5-flash

# ORCHESTRATOR_PROVIDER=gemini
# ORCHESTRATOR_MODEL=gemini-3.1-pro-preview

