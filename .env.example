# Vertex AI (Google Cloud Vertex AI Agent Platform)
# Requires one of:
#   1. VERTEX_API_KEY (simple API key auth)
#   2. google-auth / ADC (gcloud auth application-default login)
#
# Base URL pattern:
#   https://aiplatform.googleapis.com/v1beta1/projects/{project}/locations/{location}/endpoints/{endpoint}
#
# OBSERVER_PROVIDER=vertex
# OBSERVER_MODEL=gemini-2.5-flash
#
# DECIDER_PROVIDER=vertex
# DECIDER_MODEL=gemini-2.5-flash
#
# REFLECTOR_PROVIDER=vertex
# REFLECTOR_MODEL=gemini-2.5-flash
#
# ORCHESTRATOR_PROVIDER=vertex
# ORCHESTRATOR_MODEL=gemini-2.5-flash
#
# VERTEX_PROJECT_ID=mas-ai-497913
# VERTEX_LOCATION=global
# VERTEX_ENDPOINT=openapi
# VERTEX_API_KEY=your_vertex_api_key_here

LOCAL_LLM_URL=http://localhost:11434/v1
MAX_TOKENS=20000

OUTPUT_DIR=outputs
TOKEN_CONTEXT_WINDOW=200000
TOKEN_WARN_THRESHOLD=0.75

FIGMA_URL_QA=https://www.figma.com/design/your_file_key/...

# OmniParser Vision Backend
OMNIPARSER_ENABLED=false
OMNIPARSER_PROJECT_DIR=/path/to/OmniParser
OMNIPARSER_WEIGHTS_DIR=/path/to/OmniParser/weights
OMNIPARSER_BOX_THRESHOLD=0.05
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
HF_HUB_DISABLE_SYMLINKS_WARNING=1
