# Device
TARGET_DEVICE=your_device_id_here

# Perception Role (Observer — vision model)
# providers: openrouter | blackbox | openai | local
PERCEPTION_PROVIDER=openrouter
PERCEPTION_API_KEY=your_api_key_here
PERCEPTION_MODEL=google/gemini-2.0-flash-001

# Strategic Role (Orchestrator & Decider — reasoning model)
# providers: openrouter | blackbox | openai | local
STRATEGIC_PROVIDER=openrouter
STRATEGIC_API_KEY=your_api_key_here
STRATEGIC_MODEL=liquid/lfm-2.5-1.2b-thinking:free

# Base URL overrides (optional — auto-resolved from provider name if not set)
# PERCEPTION_BASE_URL=https://custom.endpoint.ai/v1
# STRATEGIC_BASE_URL=https://custom.endpoint.ai/v1

# System
LOCAL_LLM_URL=http://localhost:11434/v1
MAX_TOKENS=4000
OUTPUT_DIR=outputs

# Token Tracker
TOKEN_CONTEXT_WINDOW=32768
TOKEN_WARN_THRESHOLD=0.75
