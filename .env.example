# ORCHESTRATOR_AZURE_DEPLOYMENT=your-deployment-name

######################################################################################

# Vertex AI (Google Cloud Vertex AI Agent Platform)
# Requires one of:
#   1. VERTEX_API_KEY (simple API key auth)
#   2. google-auth / ADC (gcloud auth application-default login)
#
# Base URL pattern:
#   https://aiplatform.googleapis.com/v1beta1/projects/{project}/locations/{location}/endpoints/{endpoint}
#
# OBSERVER_PROVIDER=vertex
# OBSERVER_MODEL=gemini-2.5-flash
#
# DECIDER_PROVIDER=vertex
# DECIDER_MODEL=gemini-2.5-flash
#
# REFLECTOR_PROVIDER=vertex
# REFLECTOR_MODEL=gemini-2.5-flash
#
# ORCHESTRATOR_PROVIDER=vertex
# ORCHESTRATOR_MODEL=gemini-2.5-flash
#
# VERTEX_PROJECT_ID=mas-ai-497913
# VERTEX_LOCATION=global
# VERTEX_ENDPOINT=openapi
# VERTEX_API_KEY=your_vertex_api_key_here

LOCAL_LLM_URL=http://localhost:11434/v1

######################################################################################

# BlueSminds AI (https://bluesminds.com) — OpenAI-compatible
# Free tier: gpt-4o-mini only. Paid plans unlock more models.
# BLUESMINDS_API_KEY=your_bluesminds_api_key
#
# OBSERVER_PROVIDER=bluesminds
# OBSERVER_MODEL=gpt-4o-mini
#
# DECIDER_PROVIDER=bluesminds
# DECIDER_MODEL=gpt-4o-mini
#
# REFLECTOR_PROVIDER=bluesminds
# REFLECTOR_MODEL=gpt-4o-mini
#
# ORCHESTRATOR_PROVIDER=bluesminds
# ORCHESTRATOR_MODEL=gpt-4o-mini

######################################################################################

# Qwen via Alibaba DashScope (International) — get a key at
# https://home.qwencloud.com/api-keys. One key, two endpoint shapes:
#   "qwen"           -> OpenAI-compatible endpoint
#   "qwen-anthropic" -> Anthropic-compatible endpoint
# QWEN_API_KEY=your_qwen_dashscope_api_key
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_ANTHROPIC_BASE_URL=https://dashscope-intl.aliyuncs.com/apps/anthropic
#
# OBSERVER_PROVIDER=qwen
# OBSERVER_MODEL=qwen3.8-max
#
# DECIDER_PROVIDER=qwen
# DECIDER_MODEL=qwen3.8-max
#
# REFLECTOR_PROVIDER=qwen
# REFLECTOR_MODEL=qwen3.8-max
#
# ORCHESTRATOR_PROVIDER=qwen
# ORCHESTRATOR_MODEL=qwen3.8-max
#
# --- or, via the Anthropic-compatible endpoint instead ---
# OBSERVER_PROVIDER=qwen-anthropic
# OBSERVER_MODEL=qwen3.8-max
#
# DECIDER_PROVIDER=qwen-anthropic
# DECIDER_MODEL=qwen3.8-max
#
# REFLECTOR_PROVIDER=qwen-anthropic
# REFLECTOR_MODEL=qwen3.8-max
#
# ORCHESTRATOR_PROVIDER=qwen-anthropic
# ORCHESTRATOR_MODEL=qwen3.8-max

MAX_TOKENS=20000

OUTPUT_DIR=outputs
TOKEN_CONTEXT_WINDOW=200000
TOKEN_WARN_THRESHOLD=0.75

FIGMA_URL_QA=https://www.figma.com/design/your_file_key/...

FIGMA_REQUEST_TIMEOUT=300
HF_HUB_DOWNLOAD_TIMEOUT=300
HF_HUB_ETAG_TIMEOUT=300

# Observer production-call temperature. T=0.1, following Farquhar et al. 2024 (Nature) own
# low-temperature "best generation" baseline. Fixed value, not swept — see Dokumen Kepake checklist.
OBSERVER_TEMPERATURE=0.1

# Observer DSE uncertainty (Phase 1: measurement only; default OFF)
OBSERVER_UNCERTAINTY_ENABLED=false
# M=10, following Farquhar et al. 2024 (Nature) verbatim ("We use ten generations to compute
# entropy"). Single-paper source of truth for this whole feature. Literature-grounded, still
# not empirically validated for this Observer/Android-GUI domain.
OBSERVER_UNCERTAINTY_SAMPLES=10
# T=1.0, same Farquhar et al. 2024 source as above. NOT independently validated:
OBSERVER_UNCERTAINTY_TEMPERATURE=1.0
# Maximum widgets measured per screen to cap uncertainty-call cost.
OBSERVER_UNCERTAINTY_MAX_WIDGETS=20

# Widget detection: zero-shot VLM grounding (default), local OmniParser, or local CV/OCR fallback.
OBSERVER_DETECTION_METHOD=omniparser
OMNIPARSER_YOLO_MODEL_PATH=weights/icon_detect/model.pt
OMNIPARSER_CAPTION_MODEL_PATH=weights/icon_caption
OMNIPARSER_DEVICE=cuda
OMNIPARSER_BOX_THRESHOLD=0.05
OMNIPARSER_IOU_THRESHOLD=0.1
